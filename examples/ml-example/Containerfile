ARG HB_REGISTRY=quay.io/hummingbird
ARG RH_REGISTRY=registry.access.redhat.com

# ── Stage 1: Compile wheels and install them into a prefix ──────────────────
# Hummingbird runtime images are distroless: no /bin/sh in stage 2, so
# we cannot RUN anything in the runtime. Everything that requires a
# shell happens here. The /install prefix is what gets copied across.
FROM ${HB_REGISTRY}/python:3.13-builder AS builder
USER 1001
WORKDIR /build

ENV HOME=/build PIP_NO_CACHE_DIR=1

COPY --chown=1001:1001 requirements.txt .

# Wheel-build pulls in the C-extension build dependencies present in
# the builder image. NumPy (and torch/transformers if you uncomment
# them) compile native code here, which is exactly why we want a
# builder stage rather than installing in the runtime image.
RUN pip wheel --wheel-dir /build/wheels -r requirements.txt && \
    pip install --no-index --find-links=/build/wheels --prefix=/build/install \
        /build/wheels/*.whl

COPY --chown=1001:1001 app/ /build/app/

# ── Stage 2: Runtime on Hummingbird Python (distroless, no shell) ───────────
FROM ${HB_REGISTRY}/python:3.13
WORKDIR /app

COPY --from=builder /build/install /usr/local
COPY --from=builder --chown=1001:1001 /build/app /app/app

# Carry C++ runtime libraries from the builder. NumPy's compiled
# extensions need libstdc++ (C++ symbols) and libgcc_s (stack
# unwinding); Hummingbird's distroless Python runtime ships only the
# interpreter and its direct dependencies, so we have to bring the
# C++ runtime across explicitly. Adds ~2 MB to the deploy image.
#
# libgomp is OpenMP runtime — NumPy 2.x's bundled OpenBLAS uses it
# for parallel matrix operations. This one is delay-loaded: the
# import succeeds without it, but the first actual computation
# (e.g. np.eye(3).sum()) triggers a load that fails. The failure
# manifests as a silent SIGSEGV killing the worker; the request
# returns "Connection reset by peer" with no traceback.
#
# This pattern — selectively copying shared libraries across the
# multi-stage boundary — is also useful for other native-extension
# packages (scipy, pandas with arrow, lxml). When a package fails
# at import with `libfoo.so.X: cannot open shared object file`, OR
# when a request crashes the worker with no traceback, the cure is
# to add another COPY line here.
COPY --from=builder /usr/lib64/libstdc++.so.6* /usr/lib64/
COPY --from=builder /usr/lib64/libgcc_s.so.1*  /usr/lib64/
COPY --from=builder /usr/lib64/libgomp.so.1*   /usr/lib64/

# Both lib and lib64 — pip splits pure-Python and C-extension packages
# across them on RHEL-based systems. The runtime's default sys.path
# may not include /usr/local/lib64; set PYTHONPATH explicitly so it
# finds packages regardless of which directory pip used.
ENV PYTHONPATH=/usr/local/lib/python3.13/site-packages:/usr/local/lib64/python3.13/site-packages

USER 1001
EXPOSE 8000
CMD ["python3", "-m", "uvicorn", "app.main:app", \
     "--host", "0.0.0.0", "--port", "8000"]

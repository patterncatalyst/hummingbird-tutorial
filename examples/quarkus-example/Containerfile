ARG HB_REGISTRY=quay.io/hummingbird
ARG RH_REGISTRY=registry.access.redhat.com

# ── Stage 1: Build with UBI OpenJDK 21 (Maven pre-installed) ────────────────
# The Hummingbird openjdk:21-builder ships the JDK but not Maven —
# Hummingbird keeps builder images minimal so users only pay for the
# tools they actually want. UBI's openjdk-21 image is purpose-built
# for Java builds, with Maven and Gradle pre-installed and on PATH.
#
# We use UBI here for the build stage only. The runtime stage below
# stays on Hummingbird's distroless OpenJDK JRE — the UBI image
# never ships in the deployed artifact, so its larger CVE surface
# doesn't reach production.
FROM ${RH_REGISTRY}/ubi9/openjdk-21:latest AS builder
USER root
WORKDIR /build

COPY pom.xml ./
RUN mvn -B -ntp dependency:go-offline

COPY src ./src
RUN mvn -B -ntp package -DskipTests

# Quarkus 3.x produces target/quarkus-app/ — a directory with the
# launcher jar plus a flat lib/ tree. Smaller and faster to copy than
# a fat-jar, and the layers cache better across rebuilds.

# ── Stage 2: Runtime on Hummingbird OpenJDK JRE ─────────────────────────────
# openjdk:21-runtime is JRE-only — no javac, no Maven, no extra
# tooling. Smaller than the full JDK runtime; correct choice for an
# app that only needs to RUN bytecode, not compile it.
FROM ${HB_REGISTRY}/openjdk:21-runtime
WORKDIR /app

COPY --from=builder --chown=1001:1001 /build/target/quarkus-app/lib/      ./lib/
COPY --from=builder --chown=1001:1001 /build/target/quarkus-app/*.jar     ./
COPY --from=builder --chown=1001:1001 /build/target/quarkus-app/app/      ./app/
COPY --from=builder --chown=1001:1001 /build/target/quarkus-app/quarkus/  ./quarkus/

USER 1001
EXPOSE 8080

ENV JAVA_OPTS_APPEND="-Dquarkus.http.host=0.0.0.0 -Djava.util.logging.manager=org.jboss.logmanager.LogManager"

CMD ["java", "-jar", "quarkus-run.jar"]

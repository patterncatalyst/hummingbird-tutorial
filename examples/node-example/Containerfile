# Companion Containerfile for §4 of the tutorial. Identical to the
# inline snippet — kept here as a runnable file so `podman build .`
# in this directory works without copy-pasting from the docs.

ARG HB_REGISTRY=quay.io/hummingbird
ARG RH_REGISTRY=registry.access.redhat.com

# ── Stage 1: Build with the Hummingbird Node builder ────────────────────────
FROM ${HB_REGISTRY}/nodejs:20-builder AS builder
USER 1001
WORKDIR /build

# npm uses ~/.npm for the cache and writes package-lock.json into the
# working directory. The Hummingbird builder doesn't set HOME for UID
# 1001 and the WORKDIR is owned by root, so npm fails with
# "EACCES permission denied". Set HOME and the npm cache to /build.
# See _docs/17-distroless-gotchas.md for the full pattern.
ENV HOME=/build NPM_CONFIG_CACHE=/build/.npm

COPY --chown=1001:1001 package*.json ./
RUN npm install --omit=dev --no-audit --no-fund

COPY --chown=1001:1001 . .

# ── Stage 2: Runtime on Hummingbird Node ────────────────────────────────────
FROM ${HB_REGISTRY}/nodejs:20
WORKDIR /app

COPY --from=builder --chown=1001:1001 /build/server.js ./
COPY --from=builder --chown=1001:1001 /build/node_modules ./node_modules
COPY --from=builder --chown=1001:1001 /build/package.json ./

USER 1001
ENV NODE_ENV=production
EXPOSE 3000

CMD ["node", "server.js"]
